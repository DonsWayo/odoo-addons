<odoo>
    <!-- Search View -->
    <record id="view_git_pull_request_search" model="ir.ui.view">
        <field name="name">git.pull_request.search</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <search string="Search Pull Requests">
                <field name="title" string="Title"/>
                <field name="description" string="Description"/>
                <field name="author_id" string="Author"/>
                <field name="repository_id" string="Repository"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="merged" string="Merged" domain="[('state', '=', 'merged')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="mine" string="My PRs" domain="[('author_id', '=', uid)]"/>
                <filter name="to_review" string="To Review" domain="[('reviewer_ids', 'in', [uid]), ('state', '=', 'open')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="by_repo" string="Repository" context="{'group_by': 'repository_id'}"/>
                    <filter name="by_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="by_target" string="Target Branch" context="{'group_by': 'target_branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_git_pull_request_list" model="ir.ui.view">
        <field name="name">git.pull_request.list</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <list string="Pull Requests" sample="1" decoration-muted="state == 'closed'" decoration-success="state == 'merged'" decoration-warning="state == 'draft'">
                <field name="number" string="#"/>
                <field name="title"/>
                <field name="state" widget="badge" options="{'classes': {'draft': 'bg-secondary', 'open': 'bg-primary', 'merged': 'bg-success', 'closed': 'bg-danger'}}"/>
                <field name="repository_id" optional="hide"/>
                <field name="source_branch_id" string="Source" optional="hide"/>
                <field name="target_branch_id" string="Target" optional="hide"/>
                <field name="author_id" optional="hide"/>
                <field name="commit_count" optional="hide" string="Commits"/>
                <field name="changed_files" optional="hide" string="Files"/>
                <field name="additions" optional="hide" string="+"/>
                <field name="deletions" optional="hide" string="-"/>
                <field name="approval_count" optional="hide" string="✓"/>
                <field name="create_date" widget="date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_git_pull_request_kanban" model="ir.ui.view">
        <field name="name">git.pull_request.kanban</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_git_pr" sample="1">
                <field name="title"/>
                <field name="state"/>
                <field name="repository_id"/>
                <field name="source_branch_id"/>
                <field name="target_branch_id"/>
                <field name="author_id"/>
                <field name="approval_count"/>
                <field name="changes_requested"/>
                <field name="is_mergeable"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_git_pr_card">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold" t-out="record.title.value"/>
                                <span class="badge" t-att-class="{
                                    'draft': 'bg-secondary',
                                    'open': 'bg-primary',
                                    'merged': 'bg-success',
                                    'closed': 'bg-danger'
                                }[record.state.value]" t-out="record.state.value"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <span t-out="record.source_branch_id.display_name"/> → <span t-out="record.target_branch_id.display_name"/>
                            </div>
                            <div class="d-flex gap-2 mt-1 small text-muted">
                                <span><i class="fa fa-code-branch"/> <t t-out="record.commit_count.value"/></span>
                                <span><i class="fa fa-check"/> <t t-out="record.approval_count.value"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_git_pull_request_form" model="ir.ui.view">
        <field name="name">git.pull_request.form</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <form string="Pull Request">
                <header>
                    <button name="action_merge" type="object" string="Merge" class="btn-primary" groups="git_hosting.group_git_manager" attrs="{'invisible': [('state', '!=', 'open'), ('is_mergeable', '=', False)]}"/>
                    <button name="action_merge" type="object" string="Squash & Merge" class="btn-primary" context="{'method': 'squash'}" groups="git_hosting.group_git_manager" attrs="{'invisible': [('state', '!=', 'open'), ('is_mergeable', '=', False)]}"/>
                    <button name="action_merge" type="object" string="Rebase & Merge" class="btn-primary" context="{'method': 'rebase'}" groups="git_hosting.group_git_manager" attrs="{'invisible': [('state', '!=', 'open'), ('is_mergeable', '=', False)]}"/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary" attrs="{'invisible': [('state', 'in', ['closed', 'merged'])]}"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" attrs="{'invisible': [('state', 'not in', ['closed', 'merged'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,merged,closed" statusbar_colors='{"draft":"secondary","open":"primary","merged":"success","closed":"danger"}'/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_merge" class="oe_stat_button" icon="fa-check" attrs="{'invisible': [('state', '!=', 'open')]}">
                            <field name="approval_count" widget="statinfo" string="Approvals"/>
                        </button>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <field name="title" class="oe_inline" placeholder="Pull Request title"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Pull Request description (supports Markdown)"/>
                        </page>
                        <page string="Changes" name="changes">
                            <field name="file_ids" mode="list,form" readonly="1">
                                <list string="Changed Files">
                                    <field name="filename"/>
                                    <field name="status" widget="badge" options="{'classes': {'added': 'bg-success', 'modified': 'bg-primary', 'removed': 'bg-danger', 'renamed': 'bg-warning'}}"/>
                                    <field name="additions"/>
                                    <field name="deletions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reviews" name="reviews">
                            <field name="review_ids" mode="list,form" readonly="1">
                                <list string="Reviews">
                                    <field name="reviewer_id"/>
                                    <field name="state" widget="badge" options="{'classes': {'pending': 'bg-secondary', 'comment': 'bg-info', 'approve': 'bg-success', 'request_changes': 'bg-danger'}}"/>
                                    <field name="commit_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Checks" name="checks">
                            <field name="check_run_ids" mode="list" readonly="1">
                                <list string="Status Checks">
                                    <field name="name"/>
                                    <field name="conclusion" widget="badge" options="{'classes': {'success': 'bg-success', 'failure': 'bg-danger', 'pending': 'bg-warning', 'cancelled': 'bg-secondary'}}"/>
                                    <field name="duration" string="Duration (s)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commits" name="commits">
                            <field name="commit_ids" mode="list" readonly="1">
                                <list string="Commits">
                                    <field name="short_sha" string="SHA"/>
                                    <field name="message_short" string="Message"/>
                                    <field name="author_name" string="Author"/>
                                    <field name="committed_date" widget="date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Settings" name="settings" groups="base.group_system">
                            <group>
                                <field name="merge_method"/>
                                <field name="milestone_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_git_pull_request" model="ir.actions.act_window">
        <field name="name">Pull Requests</field>
        <field name="res_model">git.pull_request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_git_pull_request_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>