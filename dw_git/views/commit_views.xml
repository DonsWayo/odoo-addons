<odoo>
    <!-- Search View -->
    <record id="view_git_commit_search" model="ir.ui.view">
        <field name="name">git.commit.search</field>
        <field name="model">git.commit</field>
        <field name="arch" type="xml">
            <search string="Search Commits">
                <field name="sha" string="SHA"/>
                <field name="message" string="Message"/>
                <field name="author_name" string="Author"/>
                <field name="repository_id" string="Repository"/>
                <filter name="signed" string="Signed" domain="[('is_signed', '=', True)]"/>
                <group>
                    <filter name="by_repo" string="Repository" context="{'group_by': 'repository_id'}"/>
                    <filter name="by_author" string="Author" context="{'group_by': 'author_name'}"/>
                    <filter name="by_date" string="Date" context="{'group_by': 'committed_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_git_commit_list" model="ir.ui.view">
        <field name="name">git.commit.list</field>
        <field name="model">git.commit</field>
        <field name="arch" type="xml">
            <list string="Commits" sample="1">
                <field name="short_sha" string="SHA" widget="badge" options="{'classes': {'': 'bg-dark'}}"/>
                <field name="message_short" string="Message"/>
                <field name="author_name" string="Author"/>
                <field name="committed_date" widget="datetime"/>
                <field name="repository_id" optional="hide"/>
                <field name="is_signed" string="Signed" widget="boolean_toggle" decoration-success="is_signed == True"/>
                <field name="additions" optional="hide" string="Additions" widget="git_badge" decoration-success="additions &gt; 0"/>
                <field name="deletions" optional="hide" string="Deletions" widget="git_badge" decoration-danger="deletions &gt; 0"/>
                <field name="files_changed" optional="hide" string="Files" widget="git_badge" decoration-info="files_changed &gt; 0"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_git_commit_kanban" model="ir.ui.view">
        <field name="name">git.commit.kanban</field>
        <field name="model">git.commit</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_git_commit" sample="1">
                <field name="short_sha"/>
                <field name="message_short"/>
                <field name="author_name"/>
                <field name="committed_date"/>
                <field name="repository_id"/>
                <field name="is_signed"/>
                <field name="additions"/>
                <field name="deletions"/>
                <field name="files_changed"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_git_commit_card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-dark font-monospace" t-out="record.short_sha.value"/>
                                    <i class="fa fa-check-circle text-success" t-if="record.is_signed.raw_value" role="img" aria-label="Signed" title="Signed"/>
                                </div>
                                <small class="text-muted" t-out="record.committed_date.value"/>
                            </div>
                            <div class="fw-bold text-truncate" t-out="record.message_short.value"/>
                            <div class="d-flex gap-3 mt-2 small text-muted">
                                <span><i class="fa fa-user me-1"/> <t t-out="record.author_name.value"/></span>
                                <span><i class="fa fa-plus text-success me-1"/> <t t-out="record.additions.value"/></span>
                                <span><i class="fa fa-minus text-danger me-1"/> <t t-out="record.deletions.value"/></span>
                                <span><i class="fa fa-file-code-o me-1"/> <t t-out="record.files_changed.value"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_git_commit_form" model="ir.ui.view">
        <field name="name">git.commit.form</field>
        <field name="model">git.commit</field>
        <field name="arch" type="xml">
            <form string="Commit">
                <header>
                    <field name="is_signed" widget="boolean_toggle" string="Signed"/>
                </header>
                <sheet>

                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-secondary font-monospace px-2 py-1"
                                      title="Abbreviated commit SHA">
                                    <field name="short_sha" readonly="1" nolabel="1"/>
                                </span>
                                <div>
                                    <h3 class="mb-1"><field name="message_short" readonly="1" nolabel="1"/></h3>
                                    <small class="text-muted"><field name="author_name" readonly="1" nolabel="1"/> • <field name="committed_date" readonly="1" widget="datetime" nolabel="1"/></small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group string="Commit Info" col="4" invisible="1">
                        <field name="sha" readonly="1" class="font-monospace"/>
                        <field name="repository_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="author_name" readonly="1"/>
                        <field name="author_email" readonly="1"/>
                        <field name="author_date" readonly="1" widget="datetime"/>
                        <field name="committer_name" readonly="1"/>
                        <field name="committer_email" readonly="1"/>
                        <field name="committed_date" readonly="1" widget="datetime"/>
                    </group>

                    <group string="Stats" col="4">
                        <field name="additions" readonly="1" string="Lines Added" widget="git_badge" decoration-success="additions &gt; 0"/>
                        <field name="deletions" readonly="1" string="Lines Deleted" widget="git_badge" decoration-danger="deletions &gt; 0"/>
                        <field name="files_changed" readonly="1" string="Files Changed" widget="git_badge" decoration-info="files_changed &gt; 0"/>
                        <field name="is_signed" readonly="1" widget="boolean_toggle"/>
                    </group>

                    <group string="Signature" col="2" invisible="is_signed == False">
                        <field name="signature_verification" readonly="1" widget="text"/>
                    </group>

                    <notebook>
                        <page string="Changes" name="changes">
                            <field name="patch" nolabel="1" readonly="1"
                                   widget="git_diff_viewer"/>
                        </page>
                        <page string="Message" name="message">
                            <field name="message" readonly="1" widget="text" class="o_monospace p-3 bg-light rounded"/>
                        </page>
                        <page string="Parents" name="parents">
                            <field name="parent_ids" mode="list" readonly="1">
                                <list string="Parent Commits">
                                    <field name="short_sha" string="SHA" widget="badge" options="{'classes': {'': 'bg-dark'}}"/>
                                    <field name="message_short" string="Message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Branches" name="branches">
                            <field name="branch_ids" mode="list,kanban" readonly="1">
                                <list string="Branches containing this commit">
                                    <field name="name" widget="badge" options="{'classes': {'': 'bg-primary'}}"/>
                                    <field name="is_default" widget="boolean_toggle" string="Default"/>
                                </list>
                                <kanban>
                                    <field name="name"/>
                                    <field name="is_default"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click">
                                                <span class="badge bg-primary me-1" t-out="record.name.value"/>
                                                <i class="fa fa-home text-info" t-if="record.is_default.raw_value" role="img" aria-label="Default branch"/>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_git_commit" model="ir.actions.act_window">
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No commits yet</p>
            <p>Commits appear here automatically after a push. Each push syncs the branch and its recent history from the repository on disk.</p>
        </field>
        <field name="name">Commits</field>
        <field name="res_model">git.commit</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_git_commit_search"/>
    </record>
</odoo>