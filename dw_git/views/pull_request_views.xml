<odoo>
    <!-- Search View -->
    <record id="view_git_pull_request_search" model="ir.ui.view">
        <field name="name">git.pull_request.search</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <search string="Search Pull Requests">
                <field name="title" string="Title"/>
                <field name="description" string="Description"/>
                <field name="author_id" string="Author"/>
                <field name="repository_id" string="Repository"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="merged" string="Merged" domain="[('state', '=', 'merged')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="mine" string="My PRs" domain="[('author_id', '=', uid)]"/>
                <filter name="to_review" string="To Review" domain="[('reviewer_ids', 'in', [uid]), ('state', '=', 'open')]"/>
                <group>
                    <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="by_repo" string="Repository" context="{'group_by': 'repository_id'}"/>
                    <filter name="by_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="by_target" string="Target Branch" context="{'group_by': 'target_branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_git_pull_request_list" model="ir.ui.view">
        <field name="name">git.pull_request.list</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <list string="Pull Requests" sample="1" decoration-muted="state == 'closed'" decoration-success="state == 'merged'" decoration-warning="state == 'draft'">
                <field name="number" string="#" widget="git_badge"/>
                <field name="title" string="Title"/>
                <field name="state" widget="badge" decoration-primary="state == 'open'" decoration-success="state == 'merged'" decoration-danger="state == 'closed'" decoration-muted="state == 'draft'" string="Status"/>
                <field name="repository_id"/>
                <field name="source_branch_id" string="Source" widget="badge"/>
                <field name="target_branch_id" string="Target" widget="badge"/>
                <field name="author_id"/>
                <field name="commit_count" optional="hide" string="Commits" widget="git_badge" decoration-info="commit_count &gt; 0"/>
                <field name="changed_files" optional="hide" string="Files" widget="git_badge" decoration-info="changed_files &gt; 0"/>
                <field name="additions" optional="hide" string="Additions" widget="git_badge" decoration-success="additions &gt; 0"/>
                <field name="deletions" optional="hide" string="Deletions" widget="git_badge" decoration-danger="deletions &gt; 0"/>
                <field name="approval_count" string="Approvals" widget="git_badge" decoration-success="approval_count &gt; 0"/>
                <field name="changes_requested" optional="hide" string="Changes Req." widget="git_badge" decoration-danger="changes_requested"/>
                <field name="is_mergeable" string="Mergeable" widget="boolean_toggle"/>
                <field name="create_date" widget="datetime" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_git_pull_request_kanban" model="ir.ui.view">
        <field name="name">git.pull_request.kanban</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_git_pr" sample="1">
                <field name="title"/>
                <field name="state"/>
                <field name="number"/>
                <field name="source_branch_id"/>
                <field name="target_branch_id"/>
                <field name="author_id"/>
                <field name="approval_count"/>
                <field name="changes_requested"/>
                <field name="is_mergeable"/>
                <field name="commit_count"/>
                <field name="changed_files"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_git_pr_card d-flex flex-column gap-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge me-1" t-att-class="record.state.raw_value == 'draft' ? 'bg-secondary' : record.state.raw_value == 'open' ? 'bg-primary' : record.state.raw_value == 'merged' ? 'bg-success' : 'bg-danger'"
                                          t-out="record.state.value"/>
                                    <span class="badge bg-secondary" t-if="record.number.raw_value" t-out="'#' + record.number.raw_value"/>
                                </div>
                                <span class="text-success small" t-if="record.is_mergeable.raw_value and record.state.raw_value == 'open'">
                                    <i class="fa fa-check-circle me-1" role="img" aria-label="Mergeable"/> Ready
                                </span>
                            </div>
                            <h6 class="mb-0 fw-bold"><field name="title"/></h6>
                            <div class="d-flex align-items-center gap-1 small text-muted">
                                <i class="fa fa-code-fork text-info" role="img" aria-label="Source"/>
                                <field name="source_branch_id" class="badge bg-info text-dark"/>
                                <i class="fa fa-arrow-right text-muted" role="img" aria-label="to"/>
                                <i class="fa fa-code-fork text-primary" role="img" aria-label="Target"/>
                                <field name="target_branch_id" class="badge bg-primary text-dark"/>
                            </div>
                            <div class="d-flex gap-3 small text-muted">
                                <span><i class="fa fa-history me-1" role="img" aria-label="Commits"/><t t-out="record.commit_count.value"/> commits</span>
                                <span><i class="fa fa-file-code-o me-1" role="img" aria-label="Files"/><t t-out="record.changed_files.value"/> files</span>
                                <span class="text-success"><i class="fa fa-check me-1" role="img" aria-label="Approvals"/><t t-out="record.approval_count.value"/> approvals</span>
                                <span class="text-danger" t-if="record.changes_requested.raw_value">
                                    <i class="fa fa-exclamation-triangle me-1" role="img" aria-label="Changes requested"/> changes requested
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <field name="author_id" widget="many2one_avatar_user" class="small"/>
                                <small class="text-muted"><t t-out="record.author_id.value"/></small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_git_pull_request_form" model="ir.ui.view">
        <field name="name">git.pull_request.form</field>
        <field name="model">git.pull_request</field>
        <field name="arch" type="xml">
            <form string="Pull Request">
                <header>
                    <button name="action_merge" type="object" string="Merge" class="btn-primary" groups="dw_git.group_git_manager" invisible="state != 'open' and is_mergeable == False" icon="fa-check" confirm="Merge this pull request?"/>
                    <button name="action_merge" type="object" string="Squash &amp; Merge" class="btn-primary" context="{'method': 'squash'}" groups="dw_git.group_git_manager" invisible="state != 'open' and is_mergeable == False" icon="fa-compress" confirm="Squash and merge this pull request?"/>
                    <button name="action_merge" type="object" string="Rebase &amp; Merge" class="btn-primary" context="{'method': 'rebase'}" groups="dw_git.group_git_manager" invisible="state != 'open' and is_mergeable == False" icon="fa-code-fork" confirm="Rebase and merge this pull request?"/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary" invisible="state in ['closed', 'merged']" icon="fa-times" confirm="Close this pull request?"/>
                    <button name="action_refresh_changes" type="object" string="Refresh Changes" class="btn-secondary" icon="fa-refresh"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-secondary" invisible="state not in ['closed', 'merged']" icon="fa-refresh"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,merged,closed" statusbar_colors='{"draft":"secondary","open":"primary","merged":"success","closed":"danger"}'/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_merge" class="oe_stat_button" icon="fa-check" invisible="state != 'open'" string="Merge">
                            <field name="approval_count" widget="statinfo" string="Approvals"/>
                        </button>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <field name="state" widget="badge" decoration-primary="state == 'open'" decoration-success="state == 'merged'" decoration-danger="state == 'closed'" decoration-muted="state == 'draft'" class="me-2"/>
                                <!-- The badge widget renders its own <span class="badge">, so a
                                     bg-* in `class` paints the field WRAPPER instead: a square
                                     black block behind a rounded pill, with the corners bleeding
                                     out around it. Colour goes through decoration-*
                                     attributes; the badge widget has no
                                     `classes` option and never read one. -->
                                <field name="number" widget="git_badge" class="me-2"/>
                                <div class="oe_title flex-grow-1 mb-0">
                                    <h3 class="mb-0"><field name="title" nolabel="1" class="w-100"
                                        placeholder="What does this pull request do?"/></h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="repository_id" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                            <field name="source_branch_id" domain="[('repository_id', '=', repository_id)]" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                            <field name="target_branch_id" domain="[('repository_id', '=', repository_id)]" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="author_id" options="{'no_create': True}"/>
                            <field name="merge_method" widget="radio" options="{'horizontal': True}"/>
                        </group>
                    </group>



                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Pull Request description (supports Markdown)" class="o_monospace p-3 bg-light rounded"/>
                        </page>
                        <page string="Changes" name="changes">
                            <field name="file_ids" mode="list,form" readonly="1">
                                <list string="Changed Files" decoration-success="status == 'added'" decoration-danger="status == 'removed'" decoration-warning="status == 'renamed'" decoration-info="status == 'modified'">
                                    <field name="filename"/>
                                    <field name="status" widget="badge" decoration-success="status == 'added'" decoration-primary="status == 'modified'" decoration-danger="status == 'removed'" decoration-warning="status == 'renamed'" string="Status"/>
                                    <field name="additions" string="Additions" widget="git_badge" decoration-success="additions &gt; 0"/>
                                    <field name="deletions" string="Deletions" widget="git_badge" decoration-danger="deletions &gt; 0"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks" name="tasks">
                            <div class="text-muted mb-2">
                                Tasks referenced in the title or description —
                                write <code>task-42</code> to link one, or
                                <code>fixes task-42</code> to close it when this
                                pull request is merged.
                            </div>
                            <field name="task_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="stage_id"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reviews" name="reviews">
                            <field name="review_ids" mode="list,form" readonly="1">
                                <list string="Reviews" decoration-success="state == 'approve'" decoration-danger="state == 'request_changes'" decoration-info="state == 'comment'" decoration-muted="state == 'pending'">
                                    <field name="reviewer_id"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approve'" decoration-danger="state == 'request_changes'" decoration-info="state == 'comment'" decoration-muted="state == 'pending'" string="Review"/>
                                    <field name="commit_id" widget="badge"/>
                                    <field name="create_date" widget="datetime"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commits" name="commits">
                            <field name="commit_ids" mode="list,kanban" readonly="1">
                                <list string="Commits">
                                    <field name="short_sha" string="SHA" widget="badge"/>
                                    <field name="message_short" string="Message"/>
                                    <field name="author_name" string="Author"/>
                                    <field name="committed_date" widget="datetime"/>
                                </list>
                                <kanban>
                                    <field name="short_sha"/>
                                    <field name="message_short"/>
                                    <field name="author_name"/>
                                    <field name="committed_date"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="p-2 d-flex flex-column gap-1">
                                                <div class="d-flex justify-content-between">
                                                    <span class="badge bg-dark font-monospace" t-out="record.short_sha.value"/>
                                                    <small class="text-muted" t-out="record.committed_date.value"/>
                                                </div>
                                                <div class="fw-bold mt-1" t-out="record.message_short.value"/>
                                                <small class="text-muted"><t t-out="record.author_name.value"/></small>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Settings" name="settings" groups="base.group_system">
                            <group>
                                <field name="merge_method" widget="radio" options="{'horizontal': True}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_git_pull_request" model="ir.actions.act_window">
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pull requests yet</p>
            <p>A pull request proposes merging one branch into another, with review and conflict detection against the real repository.</p>
        </field>
        <field name="name">Pull Requests</field>
        <field name="res_model">git.pull_request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_git_pull_request_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <!-- Changed file: the diff for one file in a pull request -->
    <record id="view_git_pr_file_form" model="ir.ui.view">
        <field name="name">git.pr.file.form</field>
        <field name="model">git.pr.file</field>
        <field name="arch" type="xml">
            <form string="Changed File">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2 class="mb-1"><field name="filename" readonly="1" nolabel="1" class="font-monospace"/></h2>
                        <div class="d-flex align-items-center gap-2">
                            <field name="status" widget="badge" nolabel="1"
                                   decoration-success="status == 'added'"
                                   decoration-primary="status == 'modified'"
                                   decoration-danger="status == 'removed'"
                                   decoration-warning="status == 'renamed'"/>
                            <span class="badge bg-success-subtle text-success-emphasis" title="Lines added">
                                +<field name="additions" readonly="1" nolabel="1"/>
                            </span>
                            <span class="badge bg-danger-subtle text-danger-emphasis" title="Lines removed">
                                -<field name="deletions" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                    </div>
                    <notebook>
                        <page string="Diff" name="diff">
                            <field name="patch" readonly="1" nolabel="1" widget="git_diff_viewer"/>
                        </page>
                        <page string="Raw Patch" name="raw_patch">
                            <field name="patch" readonly="1" nolabel="1"
                                   class="font-monospace o-git-patch"
                                   placeholder="No diff recorded. Use Refresh Changes on the pull request to read it from the repository."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>