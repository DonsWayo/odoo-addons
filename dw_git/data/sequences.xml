<odoo>
    <!-- Sequences -->
    <record id="seq_git_pull_request" model="ir.sequence">
        <field name="name">Git Pull Request</field>
        <field name="code">git.pull.request</field>
        <field name="prefix"></field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_git_webhook_delivery" model="ir.sequence">
        <field name="name">Git Webhook Delivery</field>
        <field name="code">git.webhook.delivery</field>
        <field name="prefix">WHD</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>