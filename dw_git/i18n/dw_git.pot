#. module: dw_git
#: model:mail.template,body_html:dw_git.mail_template_git_pr_created
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"                <p><strong><t t-out=\"object.author_id.name\"/></strong> created a new pull request in <strong><t t-out=\"object.repository_id.name\"/></strong>:</p>\n"
"                <h3><a t-att-href=\"object._notify_get_action_link('view')\"><t t-out=\"object.title\"/> (#<t t-out=\"object.number\"/>)</a></h3>\n"
"                <p><t t-out=\"object.description\"/></p>\n"
"                <p>\n"
"                    <strong>Source:</strong> <t t-out=\"object.source_branch_id.name\"/><br/>\n"
"                    <strong>Target:</strong> <t t-out=\"object.target_branch_id.name\"/>\n"
"                </p>\n"
"                <p>Please review the changes.</p>\n"
"                <p>Thanks,<br/>Odoo Git Hosting</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: dw_git
#: model:mail.template,body_html:dw_git.mail_template_git_webhook_failed
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"                <p>A webhook delivery failed for <strong><t t-out=\"object.webhook_id.name\"/></strong> in repository <strong><t t-out=\"object.webhook_id.repository_id.name\"/></strong>:</p>\n"
"                <ul>\n"
"                    <li><strong>Event:</strong> <t t-out=\"object.event_type\"/></li>\n"
"                    <li><strong>URL:</strong> <t t-out=\"object.webhook_id.url\"/></li>\n"
"                    <li><strong>Response Code:</strong> <t t-out=\"object.response_code\"/></li>\n"
"                    <li><strong>Error:</strong> <t t-out=\"object.error_message\"/></li>\n"
"                </ul>\n"
"                <p>Please check the webhook configuration.</p>\n"
"                <p>Thanks,<br/>Odoo Git Hosting</p>\n"
"            </div>\n"
"        "
msgstr ""

