<odoo>
    <record id="group_git_user" model="res.groups">
        <field name="name">Git User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_git_manager" model="res.groups">
        <field name="name">Git Manager</field>
        <field name="implied_ids" eval="[(4, ref('dw_git.group_git_user'))]"/>
    </record>

    <record id="group_git_admin" model="res.groups">
        <field name="name">Git Administrator</field>
        <field name="implied_ids" eval="[(4, ref('dw_git.group_git_manager'))]"/>
    </record>

    <!-- System/admin users automatically manage Git -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('dw_git.group_git_admin'))]"/>
    </record>
</odoo>