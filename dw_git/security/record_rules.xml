<odoo>
    <!-- Repository: Owner + Members + Groups + Internal visibility -->
    <record id="git_repo_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git Repository: User Access</field>
        <field name="model_id" ref="model_git_repository"/>
        <field name="domain_force">[
                '&amp;', ('company_id', 'in', company_ids),
                '|', '|', '|',
                ('owner_id', '=', user.id),
                ('member_ids', 'in', [user.id]),
                ('group_ids', 'in', user.group_ids.ids),
                ('visibility', '=', 'internal')
            ]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Manager sees all -->
    <record id="git_repo_rule_manager" model="ir.rule">
        <field name="name">Git Repository: Manager Access</field>
        <field name="model_id" ref="model_git_repository"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>

    <!-- Branch: Access via repository -->
    <!-- Read follows repository visibility... -->
    <record id="git_branch_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git Branch: Read Access</field>
        <field name="model_id" ref="model_git_branch"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                '|', '|', '|',
                ('repository_id.owner_id', '=', user.id),
                ('repository_id.member_ids', 'in', [user.id]),
                ('repository_id.group_ids', 'in', user.group_ids.ids),
                ('repository_id.visibility', '=', 'internal')
            ]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- ...write does not. Merging advances the target branch and may delete
         the merged head branch, so repository members need this or only Git
         Managers can complete a pull request. -->
    <record id="git_branch_rule_user_write" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git Branch: Write Access</field>
        <field name="model_id" ref="model_git_branch"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                '|', '|',
                ('repository_id.owner_id', '=', user.id),
                ('repository_id.member_ids', 'in', [user.id]),
                ('repository_id.group_ids', 'in', user.group_ids.ids)
            ]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!-- Commit: Access via repository -->
    <record id="git_commit_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git Commit: User Access</field>
        <field name="model_id" ref="model_git_commit"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                '|', '|', '|',
                ('repository_id.owner_id', '=', user.id),
                ('repository_id.member_ids', 'in', [user.id]),
                ('repository_id.group_ids', 'in', user.group_ids.ids),
                ('repository_id.visibility', '=', 'internal')
            ]</field>
    </record>

    <!-- PR: Access via repository -->
    <record id="git_pr_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git PR: User Access</field>
        <field name="model_id" ref="model_git_pull_request"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                '|', '|',
                ('repository_id.owner_id', '=', user.id),
                ('repository_id.member_ids', 'in', [user.id]),
                ('repository_id.group_ids', 'in', user.group_ids.ids)
            ]</field>
    </record>

    <!-- PAT: Only owner can see own tokens -->
    <record id="git_pat_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git PAT: Owner Only</field>
        <field name="model_id" ref="model_git_personal_access_token"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- Deploy Key: Repo members with write access -->
    <record id="git_deploy_key_rule_user" model="ir.rule">
        <field name="name">Git Deploy Key: Repo Members</field>
        <field name="model_id" ref="model_git_deploy_key"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                '|',
                ('repository_id.owner_id', '=', user.id),
                ('repository_id.member_ids', 'in', [user.id])
            ]</field>
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
    </record>

    <!-- Webhook: Repo members with write access -->
    <record id="git_webhook_rule_user" model="ir.rule">
        <field name="name">Git Webhook: Repo Members</field>
        <field name="model_id" ref="model_git_webhook"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                '|',
                ('repository_id.owner_id', '=', user.id),
                ('repository_id.member_ids', 'in', [user.id])
            ]</field>
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
    </record>

    <!-- Sub-records of a pull request follow the repository's visibility.
         Without these, any employee could read every review body, every
         changed-file patch, and every webhook delivery payload. -->
    <record id="git_pr_file_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git PR File: Repo Access</field>
        <field name="model_id" ref="model_git_pr_file"/>
        <field name="domain_force">[
                '&amp;', ('pull_request_id.repository_id.company_id', 'in', company_ids),
                '|', '|',
                ('pull_request_id.repository_id.owner_id', '=', user.id),
                ('pull_request_id.repository_id.member_ids', 'in', [user.id]),
                ('pull_request_id.repository_id.group_ids', 'in', user.group_ids.ids)
            ]</field>
    </record>

    <record id="git_pr_review_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git PR Review: Repo Access</field>
        <field name="model_id" ref="model_git_pr_review"/>
        <field name="domain_force">[
                '&amp;', ('pull_request_id.repository_id.company_id', 'in', company_ids),
                '|', '|',
                ('pull_request_id.repository_id.owner_id', '=', user.id),
                ('pull_request_id.repository_id.member_ids', 'in', [user.id]),
                ('pull_request_id.repository_id.group_ids', 'in', user.group_ids.ids)
            ]</field>
    </record>

    <record id="git_webhook_delivery_rule_user" model="ir.rule">
        <field name="groups" eval="[(4, ref('dw_git.group_git_user'))]"/>
        <field name="name">Git Webhook Delivery: Repo Access</field>
        <field name="model_id" ref="model_git_webhook_delivery"/>
        <field name="domain_force">[
                '&amp;', ('webhook_id.repository_id.company_id', 'in', company_ids),
                '|',
                ('webhook_id.repository_id.owner_id', '=', user.id),
                ('webhook_id.repository_id.member_ids', 'in', [user.id])
            ]</field>
    </record>

    <record id="git_deploy_key_rule_manager" model="ir.rule">
        <field name="name">Git Deploy Key: Manager Access</field>
        <field name="model_id" ref="model_git_deploy_key"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>
    <record id="git_webhook_rule_manager" model="ir.rule">
        <field name="name">Git Webhook: Manager Access</field>
        <field name="model_id" ref="model_git_webhook"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>
    <record id="git_pr_file_rule_manager" model="ir.rule">
        <field name="name">Git PR File: Manager Access</field>
        <field name="model_id" ref="model_git_pr_file"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('pull_request_id.repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>
    <record id="git_pr_review_rule_manager" model="ir.rule">
        <field name="name">Git PR Review: Manager Access</field>
        <field name="model_id" ref="model_git_pr_review"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('pull_request_id.repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>
    <record id="git_webhook_delivery_rule_manager" model="ir.rule">
        <field name="name">Git Webhook Delivery: Manager Access</field>
        <field name="model_id" ref="model_git_webhook_delivery"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('webhook_id.repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>

    <!-- Managers see everything (per-model bypass of the global user rules) -->
    <record id="git_branch_rule_manager" model="ir.rule">
        <field name="name">Git Branch: Manager Access</field>
        <field name="model_id" ref="model_git_branch"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>
    <record id="git_commit_rule_manager" model="ir.rule">
        <field name="name">Git Commit: Manager Access</field>
        <field name="model_id" ref="model_git_commit"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>
    <record id="git_pr_rule_manager" model="ir.rule">
        <field name="name">Git Pull Request: Manager Access</field>
        <field name="model_id" ref="model_git_pull_request"/>
        <field name="groups" eval="[(4, ref('dw_git.group_git_manager'))]"/>
        <field name="domain_force">[
                '&amp;', ('repository_id.company_id', 'in', company_ids),
                (1, '=', 1)
            ]</field>
    </record>
    <!-- Every internal user is a Git User by default -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('dw_git.group_git_user'))]"/>
    </record>
</odoo>
