<odoo>
    <!-- Search View -->
    <record id="view_git_branch_search" model="ir.ui.view">
        <field name="name">git.branch.search</field>
        <field name="model">git.branch</field>
        <field name="arch" type="xml">
            <search string="Search Branches">
                <field name="name" string="Name"/>
                <field name="repository_id" string="Repository"/>
                <filter name="protected" string="Protected" domain="[('is_protected', '=', True)]"/>
                <filter name="default" string="Default" domain="[('is_default', '=', True)]"/>
                <group>
                    <filter name="by_repo" string="Repository" context="{'group_by': 'repository_id'}"/>
                    <filter name="by_protected" string="Protected" context="{'group_by': 'is_protected'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_git_branch_list" model="ir.ui.view">
        <field name="name">git.branch.list</field>
        <field name="model">git.branch</field>
        <field name="arch" type="xml">
            <list string="Branches" sample="1" multi_edit="1">
                <field name="name"/>
                <field name="repository_id" optional="hide"/>
                <field name="commit_id" optional="hide"/>
                <field name="is_protected"/>
                <field name="is_default"/>
                <field name="ahead_commits" optional="hide" string="Ahead"/>
                <field name="behind_commits" optional="hide" string="Behind"/>
                <field name="last_commit_date" optional="hide" widget="date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_git_branch_form" model="ir.ui.view">
        <field name="name">git.branch.form</field>
        <field name="model">git.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <header>
                    <field name="is_protected" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group string="Branch Info">
                        <field name="repository_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="name"/>
                        <field name="commit_sha" readonly="1"/>
                        <field name="is_default" readonly="1"/>
                        <field name="ahead_commits" readonly="1" string="Ahead"/>
                        <field name="behind_commits" readonly="1" string="Behind"/>
                    </group>

                    <notebook>
                        <page string="Protection Rules" name="protection" groups="odoogit.group_git_manager">
                            <group string="Branch Protection" col="2">
                                <field name="is_protected"/>
                                <field name="require_pr_reviews"/>
                                <field name="required_approving_reviews" invisible="require_pr_reviews == False"/>
                                <field name="dismiss_stale_reviews" invisible="require_pr_reviews == False"/>
                                <field name="require_linear_history"/>
                                <field name="require_status_checks"/>
                                <field name="required_status_check_contexts" placeholder="One check context per line" invisible="require_status_checks == False" widget="text"/>
                                <field name="allow_force_push"/>
                                <field name="allow_deletions"/>
                            </group>

                            <group string="Restricted Push Access" col="2">
                                <field name="restricted_push_user_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                                <field name="restricted_push_group_ids" widget="many2many_tags"/>
                            </group>

                            <group string="Restricted Merge Access" col="2">
                                <field name="restricted_merge_user_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_git_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">git.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_git_branch_search"/>
    </record>
</odoo>