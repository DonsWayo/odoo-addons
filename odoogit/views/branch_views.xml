<odoo>
    <!-- Search View -->
    <record id="view_git_branch_search" model="ir.ui.view">
        <field name="name">git.branch.search</field>
        <field name="model">git.branch</field>
        <field name="arch" type="xml">
            <search string="Search Branches">
                <field name="name" string="Name"/>
                <field name="repository_id" string="Repository"/>
                <filter name="protected" string="Protected" domain="[('is_protected', '=', True)]"/>
                <filter name="default" string="Default" domain="[('is_default', '=', True)]"/>
                <group>
                    <filter name="by_repo" string="Repository" context="{'group_by': 'repository_id'}"/>
                    <filter name="by_protected" string="Protected" context="{'group_by': 'is_protected'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_git_branch_list" model="ir.ui.view">
        <field name="name">git.branch.list</field>
        <field name="model">git.branch</field>
        <field name="arch" type="xml">
            <list string="Branches" sample="1" multi_edit="1">
                <field name="name" widget="badge" string="Branch" decoration-info="is_default == True"/>
                <field name="repository_id" optional="hide"/>
                <field name="commit_id"/>
                <field name="is_protected" widget="boolean_toggle" string="Protected"/>
                <field name="is_default" widget="boolean_toggle" string="Default"/>
                <field name="ahead_commits" string="Ahead" widget="badge" options="{'classes': {'0': 'bg-secondary', '1': 'bg-success', '2': 'bg-success', '3': 'bg-success', '4': 'bg-success', '5': 'bg-success', '6': 'bg-success', '7': 'bg-success', '8': 'bg-success', '9': 'bg-success', '10': 'bg-primary'}}"/>
                <field name="behind_commits" string="Behind" widget="badge" options="{'classes': {'0': 'bg-secondary', '1': 'bg-warning', '2': 'bg-warning', '3': 'bg-warning', '4': 'bg-warning', '5': 'bg-warning', '6': 'bg-warning', '7': 'bg-warning', '8': 'bg-warning', '9': 'bg-warning', '10': 'bg-danger'}}"/>
                <field name="last_commit_date" widget="datetime"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_git_branch_kanban" model="ir.ui.view">
        <field name="name">git.branch.kanban</field>
        <field name="model">git.branch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_git_branch" sample="1">
                <field name="name"/>
                <field name="repository_id"/>
                <field name="commit_id"/>
                <field name="is_protected"/>
                <field name="is_default"/>
                <field name="ahead_commits"/>
                <field name="behind_commits"/>
                <field name="last_commit_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_git_branch_card">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-code-fork text-primary fs-5" role="img" aria-label="Branch"/>
                                    <span class="fw-bold" t-out="record.name.value"/>
                                    <span t-if="record.is_default.raw_value" class="badge bg-info">Default</span>
                                </div>
                                <span t-if="record.is_protected.raw_value" class="badge bg-warning"><i class="fa fa-shield"/> Protected</span>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-history me-1"/> Latest: <t t-out="record.commit_id.value"/>
                            </div>
                            <div class="d-flex gap-3 mt-2 small text-muted">
                                <span t-if="record.ahead_commits.raw_value > 0" class="text-success"><i class="fa fa-arrow-up me-1"/> <t t-out="record.ahead_commits.value"/> ahead</span>
                                <span t-if="record.behind_commits.raw_value > 0" class="text-warning"><i class="fa fa-arrow-down me-1"/> <t t-out="record.behind_commits.value"/> behind</span>
                            </div>
                            <div class="small text-muted mt-2"><i class="fa fa-clock-o me-1"/> <t t-out="record.last_commit_date.value"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_git_branch_form" model="ir.ui.view">
        <field name="name">git.branch.form</field>
        <field name="model">git.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <header>
                    <field name="is_protected" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-code-fork text-primary fs-4" role="img" aria-label="Branch"/>
                                <field name="name" class="oe_inline" placeholder="Branch name" style="font-size: 1.5rem;"/>
                                <span class="badge bg-info ms-2" invisible="not is_default"><i class="fa fa-home me-1"/> Default</span>
                            </div>
                        </div>
                    </div>

                    <group string="Branch Info" col="4">
                        <field name="repository_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="commit_sha" readonly="1" string="Latest Commit SHA"/>
                        <field name="is_default" readonly="1"/>
                        <field name="is_protected" readonly="1"/>
                        <field name="ahead_commits" readonly="1" string="Ahead" widget="badge" options="{'classes': {'0': 'bg-secondary'}}"/>
                        <field name="behind_commits" readonly="1" string="Behind" widget="badge" options="{'classes': {'0': 'bg-secondary'}}"/>
                        <field name="last_commit_date" readonly="1" widget="datetime"/>
                    </group>

                    <notebook>
                        </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_git_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">git.branch</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_git_branch_search"/>
    </record>
</odoo>