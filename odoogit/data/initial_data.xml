<odoo>
    <!-- System parameters for git hosting -->
    <record id="odoogit_param_repo_base_path" model="ir.config_parameter">
        <field name="key">odoogit.repo_base_path</field>
        <field name="value">/var/lib/odoo/git/repos</field>
    </record>

    <record id="odoogit_param_ssh_host" model="ir.config_parameter">
        <field name="key">odoogit.ssh_host</field>
        <field name="value">git.example.com</field>
    </record>

    <!-- Cron for mirror sync -->
    <record id="git_cron_sync_mirrors" model="ir.cron">
        <field name="name">Sync Git Mirrors</field>
        <field name="model_id" ref="model_git_repository"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_mirrors()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>